---
// Affiliate outbound redirector. One static page per hotel — Booking.com ONLY.
//
// Booking.com CTAs point at /go/booking/<slug> (an internal path) instead of the
// raw CJ link. This (a) lets the GA4 click tracker in BaseLayout fire a
// provider-attributed `affiliate_click` event and (b) keeps affiliate hygiene
// (noindex + rel=sponsored) in one place.
//
// EXPEDIA IS NOT ROUTED HERE. An Expedia click may not pass through a page of
// ours that auto-forwards (the meta refresh + location.replace below) — out of
// policy for that program, flagged 2026-08-30, ref. policy 5.1.1. Expedia CTAs
// therefore carry the CJ click URL directly in the anchor; see
// `affiliateCtas()` in src/lib/affiliate-links.js. Do not re-add an
// `expedia` branch to getStaticPaths without that policy changing first.
//
// The destination is a plain provider URL from src/data/affiliates.js, wrapped
// in the CJ deep link by the shared `cjDeepLink()` helper so the property/AID
// details live in exactly one file.
import { AFFILIATE_HOTELS } from '../../../data/affiliates.js';
import { cjDeepLink } from '../../../lib/affiliate-links.js';

export function getStaticPaths() {
  const paths = [];
  for (const [slug, providers] of Object.entries(AFFILIATE_HOTELS)) {
    if (providers.bookingcom) {
      paths.push({ params: { provider: 'booking', slug }, props: { url: providers.bookingcom } });
    }
    // No expedia branch — see the policy note above.
  }
  return paths;
}

const { provider, slug } = Astro.params;
const { url } = Astro.props;
const target = cjDeepLink(provider, url, slug);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>
      Redirecting to the booking site…
      <a href={target} rel="noopener noreferrer sponsored">Continue</a>
    </p>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </body>
</html>
