---
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type. Editorial pages (city guides, hotel write-ups, the
      rooftop-pools hub) pass "article" so Pinterest treats a saved pin as an
      Article Rich Pin — it pulls the page's own title and description onto the
      pin and refreshes them when we edit the page. "website" is right for the
      homepage and for the utility pages (about, contact, terms, privacy),
      which have nothing to enrich. */
  ogType?: "website" | "article";
  /** JSON-LD graph nodes for this page (Hotel, ItemList, BreadcrumbList, …).
      Emitted as a single @graph so one script tag covers the whole page. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = "Sky & Swim · Rooftop Pool Hotels Across America",
  description = "Curated rooftop pool hotels across America — ranked by the view, the water, and whether the moment earns the price of admission.",
  ogType = "website",
  jsonLd = [],
} = Astro.props;

const site = "https://skyandswim.com";
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og-image.png", site).href;

// Site-level identity nodes ride along on every page; pages append their own
// (Hotel, ItemList, BreadcrumbList) via the `jsonLd` prop.
const graph = [
  {
    "@type": "Organization",
    "@id": `${site}/#organization`,
    name: "Sky & Swim",
    url: `${site}/`,
    logo: `${site}/apple-touch-icon.png`,
    description:
      "An independent guide to rooftop pool hotels across America, ranked by the view, the water, and whether the moment earns the price of admission.",
  },
  {
    "@type": "WebSite",
    "@id": `${site}/#website`,
    url: `${site}/`,
    name: "Sky & Swim",
    publisher: { "@id": `${site}/#organization` },
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- Short label shown under the icon when added to an iOS home screen;
         without this, iOS falls back to the long <title> and crams it. -->
    <meta name="apple-mobile-web-app-title" content="Sky & Swim" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#103868" />

    <!-- Pinterest domain claim for the Sky & Swim business account. Pinterest
         re-checks this periodically, not just at claim time — removing it
         un-claims the domain and drops pin attribution. -->
    <meta name="p:domain_verify" content="747a6e674399ecafffa835b95c07b71b" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sky & Swim" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sky & Swim — rooftop pool hotels across America" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <!-- Owner opt-out: load /?noga=1 once per device/browser to stop sending GA
         from it (works on any network — covers phone-on-cellular, laptop away
         from home Wi-Fi, etc., which IP-based internal-traffic filters miss).
         Undo with /?noga=0. Must run BEFORE the GA tags so the disable flag is
         set before gtag.js executes. -->
    <script is:inline>
      (function () {
        var KEY = 'ssNoGA';
        try {
          var noga = new URLSearchParams(location.search).get('noga');
          if (noga === '1') localStorage.setItem(KEY, '1');
          else if (noga === '0') localStorage.removeItem(KEY);
          if (localStorage.getItem(KEY) === '1') window['ga-disable-G-BNSEB2Q53S'] = true;
        } catch (e) { /* private mode / storage blocked — fail open, track normally */ }
      })();
    </script>
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BNSEB2Q53S"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-BNSEB2Q53S');
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
    />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>

    <!-- Affiliate, advisor & outbound click tracking → GA4 -->
    <script>
      // Fire a GA4 `affiliate_click` event whenever a booking or transfer link is
      // clicked. Catches the hotel booking CTAs as well as direct in-body partner
      // links (USA Transfers, Stay22 short links). Mark `affiliate_click` as a
      // key event in the GA4 UI.
      function classifyAffiliate(a) {
        // Hotel CTAs stamp data-affiliate-provider/-slug via affiliateCtas().
        // Attribution has to come off the attribute rather than the href: both
        // providers now link straight to a bare CJ click URL (jdoqocy.com), so
        // there is no readable /go/<provider>/<slug> path left to match, and
        // without this they would fall through to the anonymous `outbound_click`
        // branch below.
        const provider = a.getAttribute('data-affiliate-provider');
        if (provider) return { provider, slug: a.getAttribute('data-affiliate-slug') || '' };

        let host = '';
        try { host = new URL(a.href).hostname; } catch { return null; }
        if (host.includes('usa-transfers')) return { provider: 'usa_transfers', slug: '' };
        if (host.includes('hotels.com') || host.includes('hotelscom.stay22')) return { provider: 'hotelscom', slug: '' };
        if (host.includes('booking.com') || host.includes('booking.stay22')) return { provider: 'booking', slug: '' };
        if (host.includes('stay22.com')) return { provider: 'stay22', slug: '' };
        return null;
      }
      document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a[href]');
        if (!a || typeof window.gtag !== 'function') return;

        // Travel-advisor CTAs. Opt-in via data-advisor-cta="<placement>" rather
        // than sniffing for /contact hrefs — the footer's plain "Contact" nav
        // link is navigation, not a CTA, and counting it would inflate this
        // into meaninglessness. `interest` comes off the href's query string
        // (author-written, e.g. /contact?interest=The%20Nash), never from
        // anything a reader typed.
        const placement = a.getAttribute('data-advisor-cta');
        if (placement) {
          let interest;
          try { interest = new URL(a.href, location.origin).searchParams.get('interest') || undefined; } catch {}
          window.gtag('event', 'advisor_cta_click', { placement, interest });
          return;
        }

        // Clicks through to a hotel's own pool page. Internal, so nothing else
        // in this handler would ever record them — without this the only read on
        // "did the card work" was detail-page views minus session entrances,
        // which also counts the pick rail, related links and repeat views.
        // Opt-in via data-pool-cta="<placement>": `card` is the explicit "See
        // the pool" link, `card_body` the stretched title overlay covering the
        // rest of the card, `pick`/`pick_name` the same pair on the picks rail.
        // Splitting them keeps the CTA's own number honest while still showing
        // how much of the clickthrough the card body carries.
        const poolCta = a.getAttribute('data-pool-cta');
        if (poolCta) {
          let slug;
          try {
            // /cities/<city>/<hotel>/, /hotels/<hotel>/ and the rest all end on
            // the hotel segment, so the last path part is the slug — the same
            // `item_slug` the affiliate events use, comparable side by side.
            slug = new URL(a.href, location.origin).pathname.replace(/\/+$/, '').split('/').pop() || undefined;
          } catch {}
          window.gtag('event', 'see_the_pool', { placement: poolCta, item_slug: slug });
          return;
        }

        const hit = classifyAffiliate(a);
        if (hit) {
          let domain;
          try { domain = new URL(a.href).hostname; } catch {}
          window.gtag('event', 'affiliate_click', {
            provider: hit.provider,
            item_slug: hit.slug || undefined,
            link_url: a.href,
            link_domain: domain,
          });
          return;
        }
        // Any other link leaving the site (direct hotel sites, etc.).
        try {
          const u = new URL(a.href);
          if ((u.protocol === 'https:' || u.protocol === 'http:') && u.hostname !== location.hostname) {
            window.gtag('event', 'outbound_click', { link_url: a.href, link_domain: u.hostname });
          }
        } catch {}
      }, { capture: true });
    </script>

    <style is:global>
      :root {
        --robin: #a8d8d8;
        --shallow: #3a9aaa;
        --mid: #1a5a70;
        --deep: #0a2a48;
        --abyss: #050e22;
        --watermelon: #d44868;
        --teal: #2abfbf;

        /* Layering scale. The fixed nav is the baseline; anything that must
           cover it (drawers, overlays) goes above --z-nav. Keep full-page
           overlays on these tokens rather than ad-hoc numbers — and remember a
           positioned ancestor with its own z-index traps them regardless of
           how high they go. */
        --z-nav: 100;
        --z-backdrop: 200;
        --z-drawer: 210;

        --font-display: "Cormorant Garamond", Georgia, serif;
        --font-body: "DM Sans", system-ui, -apple-system, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: var(--font-body);
        font-weight: 400;
        color: #ffffff;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;

        /* The page IS the pool — a light sunlit surface at the very top that
           gradually deepens into dark water as you scroll down. One smooth
           ombre, scrolls with the page so the descent actually happens. */
        background: linear-gradient(
          180deg,
          #72b4bd 0%,
          #519ba7 11%,
          #34798d 23%,
          #22607c 37%,
          #154968 54%,
          #0b2e4e 72%,
          #050e22 100%
        );
        background-repeat: no-repeat;
      }

      main {
        display: block;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        margin: 0;
        font-weight: 400;
      }

      p {
        margin: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img,
      svg {
        display: block;
        max-width: 100%;
      }

      ::selection {
        background: rgba(212, 72, 104, 0.4);
        color: #fff;
      }

      .section-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 clamp(1.25rem, 4vw, 3rem);
      }
    </style>
  </body>
</html>
